<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- Remotes - explicit, do not rely on RisingOS manifest -->
  <remote name="lineage" fetch="https://github.com/LineageOS/" />
  <remote name="muppets" fetch="https://github.com/TheMuppets/" />

  <!-- Device - bramble needs both, redbull is the shared platform -->
  <project name="android_device_google_bramble" path="device/google/bramble" remote="lineage" revision="lineage-24.0" />
  <project name="android_device_google_redbull" path="device/google/redbull" remote="lineage" revision="lineage-24.0" />

  <!-- Kernel - 4.19 for redbull -->
  <project name="android_kernel_google_redbull" path="kernel/google/redbull" remote="lineage" revision="lineage-24.0" />

  <!-- Vendor blobs - only bramble -->
  <!-- There is no separate redbull vendor repo, bramble vendor covers it -->
  <project name="proprietary_vendor_google_bramble" path="vendor/google/bramble" remote="muppets" revision="lineage-24.0" />
</manifest>
